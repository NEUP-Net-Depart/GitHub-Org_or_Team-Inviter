# token 绝对不能进版本库
token.txt
.env

# 运行结果里有真实姓名和邮箱
output/

# 收集表是最大的泄露源: 真实姓名 + 邮箱 + 用户名
*.xlsx
*.xls
*.csv
*.tsv

# 备份/临时副本同样是泄露源(例如 收集表.xlsx.bak 不匹配上面的 *.xlsx)
*.bak
*.tmp
*.orig
*~

# 敏感词表(供 _test/scan_pii.py 扫描用)本身也是敏感信息, 绝不能入库
.pii-terms

# 只放行示例模板(真实收集表仍然被挡住)
!docs/**

# Python
__pycache__/
*.py[cod]
