# token 绝对不能进版本库
token.txt
.env

# 运行结果里有真实姓名和邮箱
output/

# 收集表是最大的泄露源: 真实姓名 + 邮箱 + 用户名
*.xlsx
*.xls
*.csv
*.tsv
# 注意: _test/ 的测试夹具也落在这四条规则里, 这是**故意的**。
# 夹具不进库, 由 _test/make_fixtures.py 现场生成(见 ARCHITECTURE 第十节),
# 别为了让测试跑起来就放行 *.csv —— 那等于给收集表开了个口子。

# 备份/临时副本同样是泄露源(例如 收集表.xlsx.bak 不匹配上面的 *.xlsx)
*.bak
*.tmp
*.orig
*~

# 敏感词表(供 _test/scan_pii.py 扫描用)本身也是敏感信息, 绝不能入库
.pii-terms

# 只放行示例模板(真实收集表仍然被挡住)
!docs/**

# Python
__pycache__/
*.py[cod]
